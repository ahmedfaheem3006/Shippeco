VITE_API_URL=https://api.example.com/api
VITE_WORKER_URL=https://your-worker-url.workers.dev

# Optional. Public site origin used for canonical/OG tags, structured data,
# robots.txt and sitemap.xml (src/config/publicSite.ts + scripts/prerender.mjs).
# Defaults to the currently-live https://shippeco.com when unset. Set to
# https://shippec.com ONLY as part of the actual domain migration — see
# docs/DOMAIN-MIGRATION.md. Unrelated to VITE_API_URL (the API stays on Railway).
VITE_PUBLIC_SITE_ORIGIN=
