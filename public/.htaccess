# SHIPPEC SPA + SEO rules for Hostinger (Apache/LiteSpeed).
# Deployed from Frontend/public/ into dist/ by Vite; the two marked blocks
# below are filled in at build time by scripts/prerender.mjs from the
# <Route path="..."> list in src/App.tsx (scripts/app-routes.mjs), so new
# routes are picked up automatically — never edit the generated lines in dist/.
#
# HTML files shipped in dist/ (all produced by `npm run build`):
#   - index.html — prerendered public homepage ("/"), indexable. Served
#     directly for "/" (DirectoryIndex) — no rewrite involved.
#   - app.html   — the SPA shell used by every KNOWN app route (/login,
#     /dashboard, /pay/:id, ...). Served with 200.
#   - 404.html   — the prerendered "page not found" design (+ the app's JS,
#     so it becomes the same React page once loaded). Served by
#     ErrorDocument with a real HTTP 404 for anything that is neither a real
#     file nor a known route — the URL in the address bar is not changed.
#     This includes missing /assets/*.js|css|images: they get 404, never an
#     HTML page with 200.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Tag app paths as non-indexable (read by mod_headers below). Must run
  # before any [L] rule.
  # @@NOINDEX_RULE@@

  # Real files and directories are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Known SPA routes -> app shell (200).
  # @@APP_ROUTE_RULES@@

  # No catch-all on purpose: any other path is simply not found, so the
  # server answers 404 using the ErrorDocument below.
</IfModule>

# Real 404 status + the designed page. (Without mod_rewrite this still boots
# the SPA from 404.html, just with a 404 status.)
ErrorDocument 404 /404.html

# ── noindex for the authenticated app ──
# app.html already carries <meta name="robots" content="noindex, nofollow">;
# this header is defense-in-depth for clients that only honor HTTP headers.
# It intentionally does NOT rely on robots.txt Disallow — crawlers must be
# able to fetch these paths to see the noindex signal.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=SHIPPECO_NOINDEX
</IfModule>
